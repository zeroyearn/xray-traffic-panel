[Unit]
Description=Traffic capture for xray traffic panel (dumpcap ring buffer)
Documentation=https://github.com/zeroyearn/xray-traffic-panel
After=network.target

[Service]
Type=simple
ExecStart=/root/agsbx/panel/capture.sh
Restart=always
RestartSec=3
Nice=10
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target